# Copy to .env (`cp .env.example .env`) and fill in. .env is gitignored.
# These become environment variables inside the container.

# Azure AI Foundry project endpoint.
# Find it in your Foundry project's Overview. Format:
#   https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
AZURE_AI_PROJECT_ENDPOINT=

# A model DEPLOYMENT name from your project (Models + endpoints tab, "Name" column).
MODEL_DEPLOYMENT=gpt-5-mini

# --- Optional: non-interactive auth via a service principal -------------------
# Leave blank to use `az login --use-device-code` (recommended for learning).
# If set, azure-identity's DefaultAzureCredential picks these up automatically.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
